# ============================================================
# ClauseWise Backend — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file to version control.
# ============================================================

# Google Gemini (generative AI)
GEMINI_API_KEY=

# Google Cloud service-account credentials (used by Document AI)
GOOGLE_APPLICATION_CREDENTIALS=

# Document AI processor resource name
DOCAI_PROCESSOR_ID=

# Google Cloud Translation API key
TRANSLATE_API_KEY=

# Production CORS: Comma-separated list of allowed frontend origins (e.g. https://your-site.vercel.app)
ALLOWED_ORIGINS=
